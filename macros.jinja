{%- macro help_text(variable, type) -%}
    {%- if type == 'path' -%}
        Enter {{ variable }}. This should be either a comma-separated list of single-line calls from plenoptic or torch namespaces (e.g., po.data.einstein(),torch.rand((256,256))), or the path to a script, in which case we will use its functions (see template README for details).
    {%- elif type == 'floats' -%}
        Enter {{ variable }} as either a non-negative float or a list of non-negative floats.
    {%- endif -%}
{%- endmacro -%}
