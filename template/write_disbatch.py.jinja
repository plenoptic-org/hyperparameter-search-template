#!/usr/bin/env python3

import itertools
from collections import OrderedDict
from pathlib import Path
from cyclopts import App
import warnings


app = App()

def dict_str_to_path(v):
    for char in ["{", "}", " ", "'",'"']:
        v = v.replace(char, "")
    v = v.replace(":", "-")
    return v.replace(",", "_")

@app.default
def main(
    base_out: Path = Path("{{ base_out }}"),
    for_disbatch: bool = True,
    out_file: Path = Path("disbatch.txt"),
):
    commands = []
    if not for_disbatch:
        commands.append("set -euxo pipefail")
    cluster_prefix = "{{ cluster_prefix }}"
    params = OrderedDict()
    {%- for key, hyp_dict in render_complex_params.items() %}
    params["{{ key }}"] = [{% for f in hyp_dict["choices"] %}"{{ f }}", {% endfor %}]
    {%- endfor %}
    {%- for key, (annot, value) in render_simple_params.items() %}
    params["{{ key }}"] = [{% for v in value %}"{{ v }}", {% endfor %}]
    {%- endfor %}
    {%- for key, (annot, value) in render_dict_params.items() %}
    params["{{ key }}"] = [{% for v in value %}"{{ v }}", {% endfor %}]
    {%- endfor %}
    keys = list(params.keys())

    {% raw %}
    path_keys = [k for k, v in params.items() if len(v) > 1]
    if len(path_keys) == 0:
        raise ValueError("Not searching over anything!")
    path_template = "_".join([f'{k}-{{}}' for k in path_keys]) + ".pt"
    args_template = " ".join([f'--{k} "{{}}"' for k in keys])
    print(f"{path_template=}")
    {% endraw %}
    for vals in itertools.product(*params.values()):
        path_vals = [dict_str_to_path(v) for i, v in enumerate(vals) if keys[i] in path_keys]
        outfile = base_out / path_template.format(*path_vals)
        if outfile.exists():
            warnings.warn(f"{outfile=} exists, skipping...")
            continue
        cmd = "{{ python_command }} synthesize.py " + args_template.format(*vals)
        commands.append(f"({cluster_prefix} {cmd} --out-path {outfile}) &> {outfile.with_suffix('.log')} ")

    out_file.write_text('\n'.join(commands))

if __name__ == "__main__":
    app()
