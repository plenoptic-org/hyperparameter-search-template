#!/usr/bin/env python3

import itertools
from collections import OrderedDict
from pathlib import Path
from cyclopts import App
import warnings


app = App()

def dict_str_to_path(v):
    for char in ["{", "}", " ", "'",'"']:
        v = v.replace(char, "")
    v = v.replace(":", "-")
    return v.replace(",", "_")


def get_specific_kwargs(kwargs_dict, arg_string):
    val, i = arg_string.split("-")
    tmp = kwargs_dict.get(val, "{}")
    if tmp:
        tmp = tmp[int(i)]
    return val, dict_str_to_path(tmp)


@app.default
def main(
    base_out: Path = Path("{{ base_out }}"),
    for_disbatch: bool = True,
    out_file: Path = Path("disbatch.txt"),
):
    commands = []

    # These can be modified if you wish to change them.
    if not for_disbatch:
        commands.append("set -euxo pipefail")
    cluster_prefix = "{{ cluster_prefix }}"

    # Edit the following lines in order to modify what values you will search over. As
    # long as you're using the same type of synthesis object (e.g., Metamer), you
    # shouldn't need to re-generate synthesize.py
    params = OrderedDict()
    {%- for key, hyp_dict in render_complex_params.items() %}
    params["{{ key }}"] = [{% for f in hyp_dict["choices"] %}"{{ f }}", {% endfor %}]
    {%- endfor %}
    {%- for key, (_, value) in render_simple_params.items() %}
    params["{{ key }}"] = [{% for v in value %}"{{ v }}", {% endfor %}]
    {%- endfor %}
    {%- for key, (_, value, _) in render_dict_params.items() %}
    {{ key }} = {{ value }}
    {%- endfor %}

    # The lines from here to the end of the file should probably not be modified
    {%- for key, (_, value, _) in render_dict_params.items() %}
    tmp = []
    for k in params["{{ key.split('_')[0] }}"]:
        if k in {{ key }}:
            tmp.extend([f"{k}-{i}" for i in range(len({{ key }}[k]))])
        else:
            tmp.append(f"{k}-0")
    params["{{ key.split('_')[0] }}"] = tmp
    {%- endfor %}
    keys = list(params.keys())

    path_keys = [k for k, v in params.items() if len(v) > 1]
    {%- for key, (_, value, _) in render_dict_params.items() %}
    if any([len(v) > 1 for v in {{ key }}.values()]):
        path_keys.append("{{ key }}")
    {%- endfor %}
    if len(path_keys) == 0:
        raise ValueError("Not searching over anything!")
    {% raw %}
    path_template = "_".join([f'{k}-{{{k}}}' for k in path_keys]) + ".pt"
    args_template = " ".join([f'--{k} "{{{k}}}"' for k in keys])
    print(f"{path_template=}")
    {% endraw %}
    for vals in itertools.product(*params.values()):
        vals = OrderedDict({k: v for k, v in zip(keys, vals)})
        {%- for key, (_, value, _) in render_dict_params.items() %}
        val, kw = get_specific_kwargs({{ key }}, vals['{{ key.split("_")[0] }}'])
        vals["{{ key.split("_")[0] }}"] = val
        vals["{{ key }}"] = kw
        {%- endfor %}
        outfile = base_out / path_template.format(**vals)
        if outfile.exists():
            warnings.warn(f"{outfile=} exists, skipping...")
            continue
        cmd = "{{ python_command }} synthesize.py " + args_template.format(**vals)
        commands.append(f"({cluster_prefix} {cmd} --out-path {outfile}) &> {outfile.with_suffix('.log')} ")

    out_file.write_text('\n'.join(commands))

if __name__ == "__main__":
    app()
