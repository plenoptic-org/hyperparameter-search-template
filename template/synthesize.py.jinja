from cyclopts import App
from typing import Literal
import plenoptic as po
import torch

app = App()

{%- for hyp_dict in render_hyperparams.values() %}
{{ hyp_dict["functions"] }}
{%- endfor %}

@app.default
def main(
{%- for key, hyp_dict in render_hyperparams.items() %}
    {{ key }}: Literal[{% for f in hyp_dict["choices"] %}"{{ f }}", {% endfor %}],
{%- endfor %}
    device: int | str = "cpu",
):
    """Synthesize some {{ synthesis_object }}.

    Parameters
    ----------
{%- for key in render_hyperparams %}
    {{ key }}
         Target image for {{ synthesis_object }} synthesis.
{%- endfor %}
    device
         Torch device to use.
    """
    {% if image %}
    image = {{ image }}
    {% else %}
    {% for key, hyp_dict in render_hyperparams.items() %}
    {% for f in hyp_dict["choices"] -%}
    {% if loop.first %}if{% else %}elif{% endif %} {{ key }} == "{{ f }}":
        {{ key }} = {{ hyp_dict["calls"][loop.index0] }}
    {% endfor -%}
    {% endfor -%}
    {% endif %}
    model = po.models.LuminanceGainControl(
        31, pretrained=True, pad_mode="circular", cache_filt=True
    ).eval()
    po.remove_grad(model)
    met = po.Metamer(image, model)
    print(met)
    met.synthesize(5)


if __name__ == "__main__":
    app()
