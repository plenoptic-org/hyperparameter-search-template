import ast
import time
from cyclopts import App, Parameter, Token
from typing import Literal, Annotated, Sequence
import plenoptic as po
import matplotlib.pyplot as plt
import torch
import pandas as pd
from pathlib import Path

app = App()

plt.rcParams.update({
    "axes.spines.top": False,
    "axes.spines.right": False,
    "savefig.bbox": "tight",
    "figure.dpi": 72,
})

def eval_torch(type_, tokens: Sequence[Token]):
    # converts torch/None strings to appropriate objects
    value = tokens[0].value
    if isinstance(value, str):
        if value.startswith("torch."):
            return eval(value)
        elif value == "None":
            return None
    else:
        return value


def eval_dict(type_, tokens: Sequence[Token]):
    # converts strings to dictionary of built-ins
    return ast.literal_eval(tokens[0].value)

{%- for hyp_dict in render_complex_params.values() %}
{{ hyp_dict["functions"] }}
{%- endfor %}
{%- if status_plot %}
{{ status_plot["functions"] }}
{%- endif %}

@app.default
def main(
{%- for key in search_params -%}
{% if key in render_complex_params %}
    {{ key }}: Literal[{% for f in render_complex_params[key]["choices"] %}"{{ f }}", {% endfor %}],
{%- elif key in render_simple_params %}
    {{ key }}: {{ render_simple_params[key][0] }},
{%- else %}
    {{ key }}: {{ render_dict_params[key][0] }},
{%- endif %}
{%- endfor -%}
{%- for key in non_search_params -%}
{% if key in render_complex_params %}
    {{ key }}: Literal[{% for f in render_complex_params[key]["choices"] %}"{{ f }}", {% endfor %}] = "{{ render_complex_params[key]["choices"][0] }}",
{%- elif key in render_simple_params %}
    {{ key }}: {{ render_simple_params[key][0] }} = {{ render_simple_params[key][1][0] }},
{%- else %}
    {{ key }}: {{ render_dict_params[key][0] }} = {{ render_dict_params[key][2] }},
{%- endif %}
{%- endfor -%}
    {% if animate %}n_frames: int = 50,{% endif %}
    out_path: Path = Path("synth.pt"),
    device: int | str = "cpu",
    dtype: Annotated[str, Parameter(converter=eval_torch)] = torch.float32,
):
    """Synthesize some {{ synthesis_object }} images."""
    data = {
        {%- for key in render_complex_params %}
        "{{ key }}": {{ key }},
        {%- endfor %}
        {%- for key in render_simple_params %}
        "{{ key }}": {{ key }},
        {%- endfor %}
    }
    {%- for key in render_dict_params %}
    if {{ key }}:
        data.update({f"{{key}}_{k}": v for k, v in {{ key }}.items()})
    {%- endfor %}
    {% for key, hyp_dict in render_complex_params.items() %}
    {% for f in hyp_dict["choices"] -%}
    {% if loop.first %}if{% else %}elif{% endif %} {{ key }} == "{{ f }}":
        {{ key }} = {{ hyp_dict["calls"][loop.index0] }}
    {% endfor -%}
    {% endfor -%}
    {% if model %}
    po.remove_grad(model)
    {% endif %}
    synth = po.{{ synthesis_object }}(
    {%- for key in init_params %}
        {{ key }}={{ key }},
    {%- endfor %}
    )
    {% if setup_params %}
    synth.setup(
    {%- for key in setup_params %}
        {{ key }}={{ key }},
    {%- endfor %}
    )
    {% endif %}
    print(synth)
    device = torch.device(device)
    synth.to(device)
    synth.to(dtype)
    start = time.time()
    synth.synthesize(
    {%- for key in synth_params %}
        {{ key }}={{ key }},
    {%- endfor %}
        {% if animate %}store_progress=max_iter//n_frames,{% endif %}
    )
    stop = time.time()
    synth.save(out_path)
    {% if animate %}
    ani_path = out_path.with_suffix(".mp4")
    po.plot.synthesis_animate(synth).save(ani_path)
    {% endif %}
    img_path = out_path.with_suffix(".png")
    po.plot.synthesis_imshow(synth).figure.savefig(img_path)
    {% if status_plot %}
    {%- for func in status_plot["calls"] -%}
    plot_path = out_path.with_name(f"{out_path.stem}-{{func}}.svg")
    {{ func }}(synth).savefig(plot_path)
    {%- endfor -%}
    {% else %}
    plot_path = out_path.with_suffix(".svg")
    po.plot.synthesis_status(synth).savefig(plot_path)
    {% endif %}
    data.update({
        "synthesis_duration": stop - start,
        "out_path": out_path,
        "image_path": img_path,
        {%- if animate %}"animate_path": ani_path,{%- endif %}
        {% if optimized_synthesis %}"synthesis_loss": synth.losses[-1].item(),
        "synthesis_penalty": synth.penalties[-1].item(),{%- endif %}
        "device": str(device),
        "dtype": str(dtype),
    })
    csv_path = out_path.with_suffix(".csv")
    pd.DataFrame(data, index=[0]).to_csv(csv_path, index=False)


if __name__ == "__main__":
    app()
